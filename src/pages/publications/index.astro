---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Publications, Outreach & Scholarships"
  description="Publications, outreach, presentations, and awards of Filippo Carmenati."
  bodyClass="publications"
>
  <style is:global>
    main .pub-heading { font-size: 36px; font-weight: 700; margin: 0 0 1.5rem; }
    main .pub-body h2 {
      font-size: 24px;
      font-weight: 700;
      margin: 2.25rem 0 1rem;
    }
    main .pub-body h2:first-child { margin-top: 0; }
    main .pub-body h3 {
      font-size: 19px;
      font-weight: 700;
      margin: 1.5rem 0 0.75rem;
    }
    main .pub-body ul {
      list-style: none;
      padding: 0;
      margin: 0 0 1rem;
    }
    main .pub-body ul li {
      font-size: 17px;
      line-height: 1.55;
      margin: 0 0 0.9rem;
    }
    main .pub-body .award {
      font-size: 17px;
      line-height: 1.55;
      margin: 0 0 1.25rem;
    }
  </style>

  <h1 class="pub-heading">Publications, Outreach &amp; Scholarships</h1>

